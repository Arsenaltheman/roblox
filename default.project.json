{
  "name": "CritterExpress",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Packages": {
        "$className": "Folder",
        "Vide": {
          "$path": "vendor/vide/src"
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "Packages": {
        "$className": "Folder",
        "ProfileStore": {
          "$path": "vendor/ProfileStore/ProfileStore.luau"
        }
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 17.4,
        "GeographicLatitude": 35,
        "Brightness": 2.6,
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 0.6,
        "GlobalShadows": true,
        "OutdoorAmbient": [0.66, 0.52, 0.42],
        "Ambient": [0.27, 0.2, 0.17],
        "ExposureCompensation": 0.1
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.32,
          "Offset": 0.12,
          "Color": [0.96, 0.78, 0.6],
          "Decay": [0.85, 0.5, 0.36],
          "Glare": 0.45,
          "Haze": 1.6
        }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0.06,
          "Spread": 0.8
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.6,
          "Size": 28,
          "Threshold": 1.4
        }
      },
      "Grade": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Saturation": 0.12,
          "Contrast": 0.08,
          "TintColor": [1, 0.97, 0.92]
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true
      }
    }
  }
}
