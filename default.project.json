          "$path": "src/client"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "ClockTime": 17.2,
        "GeographicLatitude": 35,
        "Brightness": 2.4,
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 0.45,
        "GlobalShadows": true,
        "ShadowSoftness": 0.3,
        "OutdoorAmbient": [0.7, 0.6, 0.56],
        "Ambient": [0.34, 0.28, 0.26],
        "ColorShift_Top": [0.4, 0.28, 0.16],
        "ColorShift_Bottom": [0.14, 0.12, 0.18],
        "ExposureCompensation": 0.15
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.3,
          "Offset": 0.15,
          "Color": [0.95, 0.78, 0.62],
          "Decay": [0.86, 0.54, 0.4],
          "Glare": 0.35,
          "Haze": 1.5
