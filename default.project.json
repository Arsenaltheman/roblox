        "$properties": {
          "Intensity": 0.07,
          "Spread": 0.55
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.45,
          "Size": 24,
          "Threshold": 1.8
        }
      },
      "Grade": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0.02,
          "Saturation": 0.15,
          "Contrast": 0.1,
          "TintColor": [1, 0.97, 0.92]
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true
      }
    }
  }
