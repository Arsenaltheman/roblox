{
  "name": "CritterExpress",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Packages": {
        "$className": "Folder",
        "Vide": {
          "$path": "vendor/vide/src"
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "Packages": {
        "$className": "Folder",
